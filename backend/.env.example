APP_NAME=Night Mode API
APP_ENV=production
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost,https://your-frontend-domain.com

DATABASE_URL=postgresql+psycopg://night_mode:night_mode@db:5432/night_mode

AUTH_MODE=required
JWT_SECRET=replace-with-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
JWT_ISSUER=night-mode-api
JWT_AUDIENCE=night-mode-client
REFRESH_COOKIE_NAME=nm_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

GEOCODER_PRIMARY=nominatim
GEOCODER_TIMEOUT_SECONDS=1

NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_API_KEY=
NOMINATIM_USER_AGENT=night-mode-api/1.0
NOMINATIM_EMAIL=

YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/1.x/
YANDEX_GEOCODER_API_KEY=

GOOGLE_GEOCODER_URL=https://maps.googleapis.com/maps/api/geocode/json
GOOGLE_GEOCODER_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=https://your-frontend-domain.com/ru/competitions
TELEGRAM_WEBAPP_TITLE=NM Clicker
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

CLICKER_MAX_TAPS_PER_SECOND=10
CLICKER_REFERRAL_BONUS_LEVELS=3
CLICKER_DAILY_BONUS_PER_LEVEL=1000
CLICKER_ADMIN_TOKEN=
REFERRAL_BONUS_REFERRER=3000
REFERRAL_BONUS_REFERRED=1000
ADMIN_PASSWORD_AUTH_ENABLED=false
